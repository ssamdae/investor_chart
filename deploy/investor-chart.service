[Unit]
Description=Investor Chart Streamlit
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/investor_chart
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/apps/investor_chart/.venv/bin/python -m streamlit run app.py --server.address=127.0.0.1 --server.port=49299 --browser.gatherUsageStats=false --server.headless=true
Restart=always
RestartSec=10
UMask=0077

[Install]
WantedBy=multi-user.target
