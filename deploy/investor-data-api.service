[Unit]
Description=Investor Chart read-only data API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/investor_chart
ExecStart=/home/ubuntu/apps/investor_chart/.venv/bin/python -m uvicorn data_api:create_app --factory --host 127.0.0.1 --port 49300 --workers 1 --no-access-log
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
